  "kit": {
    "abi": 1,
    "minAPI": "1.20.1"
  },
  "minAppVersion": "16.0.1",
  "capabilities": [
    "shelf-read",
    "shelf-write"
  ],
  "surfaces": [
    "shelf-widget"
  ],
  "icon": "Blip.icon",
  "creator": {
    "name": "Nilambar Behera",
    "kind": "community",
    "url": "https://github.com/NilambarSonu/Blip_Droplet",
    "avatar": "creator.png"
  },
  "source": {
    "repository": "https://github.com/NilambarSonu/Blip_Droplet",
    "license": "MIT"
  },
  "keywords": [
    "blip",
    "transfer",
    "android",
    "file",
    "shelf",
    "drop"
  ]
}
